PROJECT_ID=
GCP_LOCATION=us
MODEL_VERSION=gemini-3.5-flash
TEST_VARIABLE=AIF
TEMPORAL_GCS_BUCKET=
TEMPORAL_GCS_PATH=Nature_breakdown/temporal_name_to_cui.json
# ============================================================================
# >>> UPDATE PER ENVIRONMENT: document-cluster service + BigQuery (needed by /v2 and /v3) <<<
# Without CLUSTER_SELECTION_URL and CLUSTER_BQ_DATASET, /v2 and /v3 answer 503 cluster_service_unavailable.
# ============================================================================
# Cluster-selection service endpoint (Cloud Run URL incl. path; also the identity-token audience)
CLUSTER_SELECTION_URL=
# BigQuery project / dataset / location holding the cluster tables (project defaults to PROJECT_ID)
CLUSTER_BQ_PROJECT=
CLUSTER_BQ_DATASET=
CLUSTER_BQ_LOCATION=US
# Table names inside that dataset (change only if the tables are named differently)
CLUSTER_MEMBER_TABLE=SCENARIO_6_MEMBER
CLUSTER_MAP_TABLE=SCENARIO_6_MAP
CLUSTER_CLUSTER_TABLE=SCENARIO_6_CLUSTER
# Cluster set name sent to the service
CLUSTER_SET=loinc_document_v001
# ============================================================================
# ----------------------------------------------------------------------------
# Transaction-selection pipeline for record types (the standalone link-code flow):
# cluster selection -> activities -> Stage 1 -> related documents -> Stage 2 -> document
# classes -> Stage 3 -> CUIs. Runs when TRANSACTION_SELECTION_URL is set (mode auto).
# RECORD_TYPE_RESOLUTION_MODE: auto | transactions | cluster
# ----------------------------------------------------------------------------
TRANSACTION_SELECTION_URL=
# RECORD_TYPE_RESOLUTION_MODE=auto
# TRANSACTION_SELECTION_MODEL=gemini-2.5-flash
CLUSTER_ACTIVITY_TABLE=SCENARIO_6_ACTIVITY_CODE_DETAILS_ARRAY
CLUSTER_ALL_RESULTS_TABLE=all_results
# CLUSTER_ALL_RESULTS_DOC_COLUMN=document_type
# CLUSTER_ALL_RESULTS_CLASS_COLUMN=document_class
# CLUSTER_ALL_RESULTS_CODE_COLUMN=node_id
# TRANSACTION_BATCH_SIZE=25
# TRANSACTION_MAX_WORKERS=8
# TRANSACTION_MAX_RETRIES=5
# TRANSACTION_RETRY_DELAY_SECONDS=3
# TRANSACTION_REQUEST_TIMEOUT_SECONDS=300
# Cluster-selection response field(s) carrying member document names
# CLUSTER_MEMBER_NAME_KEYS=member_name
# Document catalog (MEMBER -> MAP -> CLUSTER join cached in memory) and member-name matching
# CLUSTER_DOCUMENT_CATALOG_TTL_SECONDS=3600
# CLUSTER_MEMBER_MATCH_MIN_SIMILARITY=0.75
# CLUSTER_MEMBER_MATCH_MIN_TOKEN_SCORE=0.6
# CLUSTER_ALIAS_TEXTS_MAX=2
# CLUSTER_SELECTION_MAX_WORKERS=8
# Keep the /v1 vocabulary CUIs for a record type the cluster could not code
# RECORD_TYPE_JSON_FALLBACK=true
# Model fallback for record types still uncoded after every deterministic stage
# RECORD_TYPE_LLM_FALLBACK=true
# RECORD_TYPE_LLM_FALLBACK_MODEL=
# RECORD_TYPE_LLM_FALLBACK_MAX_LABELS=400
# Optional tag vocabulary for /v2 and /v3 (same shape as the record-type vocabulary)
TAG_GCS_BUCKET=
# TAG_GCS_PATH=Nature_breakdown/tag_name_to_cui.json
# TAG_LOCAL_PATH=
# /v3/retrieval-signals - canonical temporal mode (all optional; defaults shown)
# TEMPORAL_INDEX_SIMILARITY_PROVIDER=lexical
# TEMPORAL_EMBEDDING_MODEL=
# TEMPORAL_INDEX_CACHE_DIR=
# TEMPORAL_MAX_CODES_PER_WINDOW=2
# TEMPORAL_MIN_SIMILARITY=0.3
# TEMPORAL_MENU_MAX_VALUES=12
# TEMPORAL_MENU_UNITS=day,week,month,year
# TEMPORAL_SHORTLIST_TOP_N=8
# TEMPORAL_SHORTLIST_MIN_SCORE=0.3
TEMPORAL_SHADOW_MODE=false
# Cadence memory built by scripts/build_cadence_memory.py (optional)
CADENCE_MEMORY_GCS_BUCKET=
# CADENCE_MEMORY_GCS_PATH=Nature_breakdown/cadence_memory.json
# CADENCE_MEMORY_LOCAL_PATH=app/cadence_memory.json
# CADENCE_MEMORY_EXAMPLES_PER_CONCEPT=3
# CADENCE_MEMORY_MAX_CONCEPTS=10
# CADENCE_MEMORY_MIN_SIMILARITY=0.6
